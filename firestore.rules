rules_version = '2';

// Revital Hub — Firestore security rules
//
// Data model:
//   agency/clientsDb   — full internal client database (every tool's data).
//                         Admin-only. Never read by the public portal.
//   hub/settings       — internal hub settings. Admin-only.
//   clients/{clientId} — public "capability" projection. One document per
//                         client, containing ONLY what the client portal
//                         needs (branding + checklist). The document ID
//                         *is* the crypto-secure magic link token, so
//                         holding the link is what grants access — the
//                         same model as an "anyone with the link" share.
//                         Listing the collection is always denied, so it
//                         can't be enumerated/scraped.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Any @revitalproductions.com Google account counts as admin, not
      // just one hardcoded address - keeps this in sync with the same
      // domain-wide check in app.js / _worker.js. Without this, employees
      // could sign in but every Firestore read/write would still 403.
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.*@revitalproductions[.]com$');
    }

    // ── Team Access enforcement ──
    // Real, database-level backing for the Team Access tool (see
    // team-access-manager/js/app.js), not just the UI hiding sidebar
    // buttons for restricted teammates. Before this, ANY
    // @revitalproductions.com account could read/write every document
    // under agency/ regardless of what Team Access showed them - the
    // restriction only ever hid nav buttons client-side, so opening
    // devtools (or just calling the Firebase SDK directly) bypassed it
    // completely.
    //
    // Firestore rules are document-level, not field-level: they can grant
    // or deny a whole document, but can't hand back "only these fields"
    // of one. Team Access's 11 sections are a UI-level split within
    // documents that mix many sections' data together (clientsDb-shard-N
    // holds nearly every tool's per-client fields in one object per
    // client), so true per-section slicing at this layer isn't possible
    // without routing restricted users' reads through a server-side
    // filter that classifies every field of every tool by section - a
    // much larger project, deliberately not built here. What IS
    // enforceable at this layer, and what this adds: a
    // restricted teammate with NONE of the relevant sections is now
    // actually blocked at the database level, not just steered around it
    // in the UI. Someone with at least one relevant section still gets
    // the whole document once past the gate (same as today) - the Team
    // Access UI's finer section list is what governs what they actually
    // see and use inside the Hub.
    //
    // Mirrors effectiveSections() in team-access-manager/js/app.js as
    // closely as rules syntax allows - keep both in sync if that logic
    // changes.
    function normalizedEmail() {
      return request.auth.token.email.lower();
    }
    function teamAccessData() {
      return get(/databases/$(database)/documents/agency/teamAccess).data;
    }
    function isRestricted() {
      return exists(/databases/$(database)/documents/agency/teamAccess)
        && normalizedEmail() in teamAccessData().get('users', {});
    }
    function userEntry() {
      return teamAccessData().users[normalizedEmail()];
    }
    function effectiveSections() {
      let entry = userEntry();
      let roleTiers = teamAccessData().get('roleTiers', {});
      return (entry.get('role', null) != null && entry.role in roleTiers)
        ? roleTiers[entry.role].get('sections', [])
        : entry.get('sections', []);
    }
    // Every section key except Agency Globals (see SECTION_DEFS in
    // team-access-manager/js/app.js) - kept in sync manually, same as
    // that file's own comment about the July 2026 sidebar reorg.
    function nonGlobalsSections() {
      return ['core', 'ad-accounts-access', 'reporting-health', 'production',
              'content-creation', 'account-ops', 'audits', 'strategy-competition',
              'sales-pipeline', 'retention-social-proof'];
    }
    // True for anyone with at least one reason to be in account/client
    // data at all - the all-or-nothing gate described above.
    function hasAccountDataAccess() {
      return !isRestricted() || effectiveSections().hasAny(nonGlobalsSections());
    }
    // Agency Globals (SOP & Wiki Library, Email Template Library) is the
    // one section that genuinely lives in its own documents rather than
    // bundled with everything else, so it gets its own real gate instead
    // of folding into the general one above.
    function hasAgencyGlobalsAccess() {
      return !isRestricted() || 'agency-globals' in effectiveSections();
    }

    // Covers every document under agency/ (clientsDb, activityLog, and any
    // future admin-only document), instead of allow-listing each one by
    // name and silently 403'ing new ones added later.
    match /agency/{document} {
      allow read, write: if isAdmin() && (
        // Team Access's own config: only fully-unrestricted admins can
        // read or edit who's restricted and what roles grant - otherwise
        // a restricted teammate with any section at all could reach in
        // via devtools and grant themselves more access.
        (document == 'teamAccess' || document == 'teamActivity') ? !isRestricted() :
        (document.matches('sops-shard-.*') || document == 'sopShardMeta' || document == 'sopChecklistRuns' || document == 'emailTemplates') ? hasAgencyGlobalsAccess() :
        hasAccountDataAccess()
      );
    }

    match /hub/settings {
      allow read, write: if isAdmin();
    }

    match /clients/{clientId} {
      // Anyone holding the exact document ID (the magic token) can fetch it.
      allow get: if true;

      // Nobody can list/browse the collection — this is what stops the
      // "download the whole clients list" exposure.
      allow list: if false;

      // The admin (the hub) can always fully write this doc - branding,
      // both checklists, the published report archive, anything. This is
      // deliberately unconditional on which fields changed, unlike the
      // public rule below, so a hub save that touches several fields at
      // once (or introduces a brand new field like reportArchive) never
      // gets silently rejected.
      allow write: if isAdmin();

      // Unauthenticated portal visitors may ONLY ever touch their own
      // client-facing checklist (checking off their own items), their own
      // content approval decisions (pendingApprovals shrinks,
      // approvalHistory grows, as items move from one to the other), their
      // own testimonial submission (Leave a Testimonial view - written
      // once, then read-only from the client's side), and now their own
      // notification feed - but only to flip read: false -> true on
      // entries the admin already created, never to add new ones (that's
      // enforced app-side by only ever writing back the same array with
      // read flags flipped; Firestore rules can't easily diff array
      // contents element-by-element, so this relies on the portal's own JS
      // never constructing a new notification, the same trust boundary the
      // client-side checklist/approvals already operate under). The
      // internal onboardingChecklist, branding, embed URLs, report
      // archive, etc. all stay immutable to public writes. lastVisitedAt
      // is also portal-writable - a simple "I loaded this page" timestamp
      // used to show Ronald whether a client is actually opening their
      // portal, nothing sensitive. moodBoardViews is the same idea, one
      // level more specific - a map of {boardId: firstViewedAt} the portal
      // writes when the client opens the Mood Boards tab, so Ronald gets
      // notified the first time a client actually looks at a given shared
      // board (see recordMoodBoardViews in portal/js/app.js and
      // foldInMoodBoardViews/ensureClientPortalListeners in app.js).
      // moodBoardStyleFeedback (the "how does this feel to you?" style-axis
      // sliders, saveMoodBoardStyleFeedback in portal/js/app.js) and
      // moodBoardAnnotations (pin-a-spot/circle-an-area image feedback,
      // persistMoodBoardAnnotations in the same file) were both missing
      // from this whitelist until now - meaning those saves would have been
      // silently rejected by these rules the whole time despite the
      // client-side code being fully built. Same trust boundary as the
      // notification read-flags above: nothing stops a malicious client
      // from writing garbage keys into their own doc, but the worst case is
      // bogus feedback/annotations on their own account, not a real
      // security issue.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['clientChecklist', 'pendingApprovals', 'approvalHistory', 'testimonialSubmission', 'notifications', 'lastVisitedAt', 'moodBoardViews', 'moodBoardStyleFeedback', 'moodBoardAnnotations']);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
